DISCORD_TOKEN=put_your_bot_token_here
PREFIX=!
# Optional: your Discord server ID for instant slash-command updates while testing.
TEST_GUILD_ID=
# Optional: set to the bot owner's Discord user ID for owner-only commands.
# Leave blank until you intentionally configure it.
OWNER_ID=
# On Railway, attach a persistent Volume mounted at /data, then set:
# DATABASE_PATH=/data/manager.sqlite3
# Optional: the status endpoint answers a host's public domain (Railway sets PORT).
# HEALTH_PORT overrides the port, HEALTH_HOST changes the bind address (0.0.0.0 by default),
# and HEALTH_DISABLED=1 turns the endpoint off entirely. The bot itself never needs it.
HEALTH_PORT=
HEALTH_DISABLED=
